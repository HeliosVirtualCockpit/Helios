<HeliosSdk:HeliosPropertyEditor x:Class="GadrocsWorkshop.Helios.Controls.DualPotentiometerAppearanceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:HeliosSdk="clr-namespace:GadrocsWorkshop.Helios.Windows.Controls"                      
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             Height="Auto" d:DesignWidth="180">
    <Grid Background="Transparent" Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="50"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Margin="4,10,2,2" Style="{StaticResource Heading2}">Pot 1 (Lower)</TextBlock>
        <Label Grid.Column="0" Grid.Row="1" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Image used for pot 1, the lower pot.  It is rotated about the center of the control.</Label.ToolTip> Image
        </Label>
        <HeliosSdk:ImagePicker Grid.Column="1" Grid.Row="1" ImageFilename="{Binding Control.Potentiometer1Image, Mode=TwoWay}" />
        <Label Grid.Column="0" Grid.Row="2" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Size of the pot 1 image relative to the control.  At the far right the image fills the control.</Label.ToolTip> Scale
        </Label>
        <Slider Grid.Column="1" Grid.Row="2" Minimum="0" Maximum="1" Value="{Binding Control.Potentiometer1Scale}" Margin="2" TickPlacement="BottomRight" TickFrequency="0.1"/>
        <Label Grid.Column="0" Grid.Row="3" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Rotation of pot 1 at its minimum value when pot 2 is also at its minimum value.</Label.ToolTip> Initial
        </Label>
        <Slider Grid.Column="1" Grid.Row="3" Minimum="0" Maximum="360" Value="{Binding Control.Potentiometer1InitialRotation}" Margin="2" GotFocus="Potentiometer1InitialRotation_GotFocus"/>
        <Label Grid.Column="0" Grid.Row="4" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Degrees pot 1 turns between its minimum and maximum value, measured relative to pot 2 when it follows pot 2.</Label.ToolTip> Travel
        </Label>
        <Slider Grid.Column="1" Grid.Row="4" Minimum="0" Maximum="360" Value="{Binding Control.Potentiometer1RotationTravel}" Margin="2" GotFocus="Potentiometer1RotationTravel_GotFocus"/>
        <Label Grid.Column="0" Grid.Row="5" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>When set, pot 1 turns counter-clockwise as its value increases.</Label.ToolTip> Reverse
        </Label>
        <CheckBox Grid.Column="1" Grid.Row="5" VerticalAlignment="Top" Margin="0,6,6,6" IsChecked="{Binding Path=Control.Potentiometer1CounterClockwise}" />
        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="6" Margin="4,10,2,2" Style="{StaticResource Heading2}">Pot 2 (Upper)</TextBlock>
        <Label Grid.Column="0" Grid.Row="7" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Image used for pot 2, the upper pot.  It is rotated about the center of the control.</Label.ToolTip> Image
        </Label>
        <HeliosSdk:ImagePicker Grid.Column="1" Grid.Row="7" ImageFilename="{Binding Control.Potentiometer2Image, Mode=TwoWay}" />
        <Label Grid.Column="0" Grid.Row="8" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Size of the pot 2 image relative to the control.  At the far right the image fills the control.  The mouse wheel turns pot 2 while the pointer is over this image, and pot 1 elsewhere.</Label.ToolTip> Scale
        </Label>
        <Slider Grid.Column="1" Grid.Row="8" Minimum="0" Maximum="1" Value="{Binding Control.Potentiometer2Scale}" Margin="2" TickPlacement="BottomRight" TickFrequency="0.1"/>
        <Label Grid.Column="0" Grid.Row="9" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Rotation of pot 2 at its minimum value when pot 1 is also at its minimum value.</Label.ToolTip> Initial
        </Label>
        <Slider Grid.Column="1" Grid.Row="9" Minimum="0" Maximum="360" Value="{Binding Control.Potentiometer2InitialRotation}" Margin="2" GotFocus="Potentiometer2InitialRotation_GotFocus"/>
        <Label Grid.Column="0" Grid.Row="10" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Degrees pot 2 turns between its minimum and maximum value, measured relative to pot 1 when it follows pot 1.</Label.ToolTip> Travel
        </Label>
        <Slider Grid.Column="1" Grid.Row="10" Minimum="0" Maximum="360" Value="{Binding Control.Potentiometer2RotationTravel}" Margin="2" GotFocus="Potentiometer2RotationTravel_GotFocus"/>
        <Label Grid.Column="0" Grid.Row="11" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>When set, pot 2 turns counter-clockwise as its value increases, which is the opposite direction to pot 1 if pot 1 is not reversed.</Label.ToolTip> Reverse
        </Label>
        <CheckBox Grid.Column="1" Grid.Row="11" VerticalAlignment="Top" Margin="0,6,6,6" IsChecked="{Binding Path=Control.Potentiometer2CounterClockwise}" />
        <Label Grid.Column="0" Grid.Row="12" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>When set, pot 2 is drawn over pot 1.  Clear this to draw pot 1 over pot 2.</Label.ToolTip> On Top
        </Label>
        <CheckBox Grid.Column="1" Grid.Row="12" VerticalAlignment="Top" Margin="0,6,6,6" IsChecked="{Binding Path=Control.Potentiometer2OnTop}" />
    </Grid>
</HeliosSdk:HeliosPropertyEditor>

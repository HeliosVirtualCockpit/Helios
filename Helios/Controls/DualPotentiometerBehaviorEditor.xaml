<HeliosSdk:HeliosPropertyEditor x:Class="GadrocsWorkshop.Helios.Controls.DualPotentiometerBehaviorEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:Helios="clr-namespace:GadrocsWorkshop.Helios"
             xmlns:HeliosBase="clr-namespace:GadrocsWorkshop.Helios.Controls"
             xmlns:HeliosSdk="clr-namespace:GadrocsWorkshop.Helios.Windows.Controls"                      
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             Height="Auto" d:DesignWidth="180">
    <Grid Background="Transparent" Margin="4">
        <Grid.Resources>
            <Helios:EnumConverter Type="{x:Type HeliosBase:DualPotentiometerFollowMode}" x:Key="FollowModes" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="80"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Margin="4,10,2,2" Style="{StaticResource Heading2}">Pot 1 (Lower) Value</TextBlock>
        <Label Grid.Column="0" Grid.Row="1" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Name used for pot 1 in the bindings lists.  Changing it does not break existing bindings.</Label.ToolTip> Name
        </Label>
        <HeliosSdk:HeliosTextBox Grid.Column="1" Grid.Row="1" FontSize="10" Margin="2" Text="{Binding Control.Potentiometer1Name}" />
        <Label Grid.Column="0" Grid.Row="2" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Value of pot 1 when a profile is started or reset.</Label.ToolTip> Initial
        </Label>
        <HeliosSdk:HeliosTextBox Grid.Column="1" Grid.Row="2" FontSize="10" Margin="2" Text="{Binding Control.Potentiometer1InitialValue}" />
        <Label Grid.Column="0" Grid.Row="3" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Input value at which pot 1 is at its initial rotation.</Label.ToolTip> Min
        </Label>
        <HeliosSdk:HeliosTextBox Grid.Column="1" Grid.Row="3" FontSize="10" Margin="2" Text="{Binding Control.Potentiometer1MinValue}" />
        <Label Grid.Column="0" Grid.Row="4" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Input value at which pot 1 has turned through its full rotation travel.</Label.ToolTip> Max
        </Label>
        <HeliosSdk:HeliosTextBox Grid.Column="1" Grid.Row="4" FontSize="10" Margin="2" Text="{Binding Control.Potentiometer1MaxValue}" />
        <Label Grid.Column="0" Grid.Row="5" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Amount the value of pot 1 changes for each click of the mouse wheel.</Label.ToolTip> Step
        </Label>
        <HeliosSdk:HeliosTextBox Grid.Column="1" Grid.Row="5" FontSize="10" Margin="2" Text="{Binding Control.Potentiometer1StepValue}" />
        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="6" Margin="4,10,2,2" Style="{StaticResource Heading2}">Pot 2 (Upper) Value</TextBlock>
        <Label Grid.Column="0" Grid.Row="7" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Name used for pot 2 in the bindings lists.  Changing it does not break existing bindings.</Label.ToolTip> Name
        </Label>
        <HeliosSdk:HeliosTextBox Grid.Column="1" Grid.Row="7" FontSize="10" Margin="2" Text="{Binding Control.Potentiometer2Name}" />
        <Label Grid.Column="0" Grid.Row="8" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Value of pot 2 when a profile is started or reset.</Label.ToolTip> Initial
        </Label>
        <HeliosSdk:HeliosTextBox Grid.Column="1" Grid.Row="8" FontSize="10" Margin="2" Text="{Binding Control.Potentiometer2InitialValue}" />
        <Label Grid.Column="0" Grid.Row="9" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Input value at which pot 2 is at its initial rotation.</Label.ToolTip> Min
        </Label>
        <HeliosSdk:HeliosTextBox Grid.Column="1" Grid.Row="9" FontSize="10" Margin="2" Text="{Binding Control.Potentiometer2MinValue}" />
        <Label Grid.Column="0" Grid.Row="10" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Input value at which pot 2 has turned through its full rotation travel.</Label.ToolTip> Max
        </Label>
        <HeliosSdk:HeliosTextBox Grid.Column="1" Grid.Row="10" FontSize="10" Margin="2" Text="{Binding Control.Potentiometer2MaxValue}" />
        <Label Grid.Column="0" Grid.Row="11" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Amount the value of pot 2 changes for each click of the mouse wheel.</Label.ToolTip> Step
        </Label>
        <HeliosSdk:HeliosTextBox Grid.Column="1" Grid.Row="11" FontSize="10" Margin="2" Text="{Binding Control.Potentiometer2StepValue}" />
        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="12" Margin="4,10,2,2" Style="{StaticResource Heading2}">Linkage</TextBlock>
        <Label Grid.Column="0" Grid.Row="13" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>Selects which pot is carried around by the other one.  The following pot's own value turns it relative to the pot it follows.  Choose Independent to have neither pot follow the other.</Label.ToolTip> Follow
        </Label>
        <ComboBox Grid.Column="1" Grid.Row="13" FontSize="10" Margin="0,2,0,2" HorizontalAlignment="Stretch" ItemsSource="{Binding Source={StaticResource FollowModes}, Path=DisplayNames}" SelectedItem="{Binding Path=Control.FollowMode, Converter={StaticResource FollowModes}}" />
        <Label Grid.Column="0" Grid.Row="14" FontSize="10" HorizontalAlignment="Right">
            <Label.ToolTip>When set, the mouse wheel turns pot 2 while the pointer is over the pot 2 image, and pot 1 anywhere else on the control.</Label.ToolTip> Mouse Wheel
        </Label>
        <CheckBox Grid.Column="1" Grid.Row="14" VerticalAlignment="Top" Margin="0,6,6,6" IsChecked="{Binding Path=Control.MouseWheelAction}" />
    </Grid>
</HeliosSdk:HeliosPropertyEditor>
